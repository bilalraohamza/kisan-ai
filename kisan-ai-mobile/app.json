{
  "expo": {
    "name": "Kissan Ai",
    "slug": "kisan-ai-mobile",
    "scheme": "kisanai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo_kissan_ai_finall.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/Logo_kissan_ai_finall.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.kisanaimobile"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7A1B2B",
          "android": {
            "image": "./assets/images/Logo_kissan_ai_final.png",
            "imageWidth": 120
          }
        }
      ],
      "expo-camera",
      "expo-image-picker",
      "expo-location",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "00f1ae5c-06be-4924-9be6-0a16e588f807"
      }
    },
    "owner": "hasnain01"
  }
}